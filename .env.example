# ─── AI Companion ─────────────────────────────────────────────────────────────
# Required for the Socratic AI Companion (Claude Sonnet 4)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Primary: Voyage AI (voyage-multilingual-2, 1024 dims — best for en/ru/uz)
VITE_VOYAGE_API_KEY=your_voyage_api_key

# Fallback: OpenAI (text-embedding-3-small, 1536 dims)
# Used automatically if VITE_VOYAGE_API_KEY is not set.
VITE_OPENAI_API_KEY=your_openai_api_key

# Force a specific provider: "voyage" | "openai"
# Omit to auto-select (Voyage preferred when key is present).
# VITE_RAG_EMBEDDING_PROVIDER=voyage

# ─── Application Settings ─────────────────────────────────────────────────────
VITE_DEV_MODE=true
VITE_ENABLE_RAG_DEBUG=true

# ─── Observability (optional) ─────────────────────────────────────────────────
# VITE_LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# VITE_LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# VITE_LANGFUSE_HOST=https://cloud.langfuse.com
